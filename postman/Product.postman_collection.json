            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse (Updated)\",\n  \"price\": 24.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products", "{{productId}}" ]
            }
          },
          "event": [
