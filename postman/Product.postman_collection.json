{
  "info": {
    "_postman_id": "b6e2f1a0-4b3a-4a2e-9b7c-2f6a8d9c1e10",
    "name": "Product API (Minimal API / FastEndpoints)",
    "description": "Product CRUD requests, valid and invalid examples for all five operations. Uses {{baseUrl}} so the same collection can target either the Minimal API project or the FastEndpoints project by switching Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create Product",
      "item": [
        {
          "name": "Create Product - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"price\": 19.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Location header is present', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "",
                  "pm.test('Response body has an id and correct name', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.name).to.eql('Wireless Mouse');",
                  "    pm.collectionVariables.set('productId', json.id);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Product - Invalid (empty name, negative price)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "2. Get All Products",
      "item": [
        {
          "name": "Get All Products - Valid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response body is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get All Products - Invalid (wrong path)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productsxyz",
              "host": [ "{{baseUrl}}" ],
              "path": [ "productsxyz" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "3. Get Product By Id",
      "item": [
        {
          "name": "Get Product By Id - Valid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products", "{{productId}}" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returned id matches requested id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Product By Id - Invalid (not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/999999",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products", "999999" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "4. Update Product",
      "item": [
